DATABASE_URL=postgresql://user:password@localhost/leads_db

# Configure one or more lead providers. Treg can run by itself.
SEARCH_PROVIDER=treg
TREG_TOKEN=
TREG_ORG_ID=4258
TREG_BASE_URL=https://treg.to
TREG_DEFAULT_CUSTOMER_ID=

# Required to call the private Treg invoice and budget endpoints.
BILLING_ADMIN_KEY=

# Gates the operator endpoints — /debug, /cache/*, /campaigns/{id}/seen,
# /monid/catalog and /diagnostics/* — which are sent as X-Admin-Key. They were
# public: /debug served the whole cached contact database to anyone who knew
# the URL. With neither this nor BILLING_ADMIN_KEY set they answer 503, so an
# unset variable closes them rather than opening them.
ADMIN_API_KEY=

# Optional direct-provider fallbacks.
BYTEMINE_API_KEY=
CRUSTDATA_API_KEY=
GETLEADS_API_KEY=
COLDIQ_API_KEY=
FINDYMAIL_API_KEY=
FIBER_API_KEY=
CONTACTOUT_API_KEY=
MOLTSETS_API_KEY=
ENRICHSO_API_KEY=
# Monid is a router with a wallet, not a data provider: one key reaches
# ContactOut and Hunter (and more of its catalog) through a single balance.
# ContactOut rides on this whenever CONTACTOUT_API_KEY is unset.
# RouterGrowth is a second router, and the cheapest leg in the chain: its
# people search bills $0.002 a call plus $0.000374 a person returned and
# nothing on a miss, and its email verifier runs a 3-provider failover inside
# one $0.002 call. Setting this puts it second in the search chain and first
# among the verification fallbacks.
ROUTERGROWTH_API_KEY=
MONID_API_KEY=
# JSON corrections to the Monid tool table, as {"logical_name":
# "provider:endpoint"}. Only needed when GET /monid/catalog reports a tool as
# unknown; it prints the live spelling to paste here.
MONID_ENDPOINT_OVERRIDES=
WIZA_API_KEY=

# Optional ICP parser enhancement.
ANTHROPIC_API_KEY=
USE_LLM_PARSER=false
SEARCH_CACHE_TTL_SECONDS=3600
